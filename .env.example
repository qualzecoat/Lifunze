# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env!

# --- Database (Dipakai docker-compose. Nilai default ada di compose, ini override) ---
POSTGRES_USER=lifunze
POSTGRES_PASSWORD=ganti-password-yang-kuat
POSTGRES_DB=lifunze

# --- Lifunze API (wajib di production) ---
LIFUNZE_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
LIFUNZE_FERNET_KEY=                       # 32 byte urlsafe base64 untuk enkripsi API key AI
LIFUNZE_ADMIN_USERNAME=                   # seed admin pertama (Fase 1)
LIFUNZE_ADMIN_PASSWORD=                   # seed admin pertama (Fase 1)

# --- Dev lokal tanpa Docker ---
# LIFUNZE_DATABASE_URL=sqlite:///./lifunze-dev.db
