# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env!
# Generate rahasia:
#   SECRET_KEY & POSTGRES_PASSWORD: openssl rand -hex 32
#   FERNET_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Database (Dipakai docker-compose. Nilai default ada di compose, ini override) ---
POSTGRES_USER=lifunze
POSTGRES_PASSWORD=ganti-password-yang-kuat
POSTGRES_DB=lifunze

# --- Lifunze API (wajib di production) ---
LIFUNZE_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
LIFUNZE_FERNET_KEY=                       # 32 byte urlsafe base64 untuk enkripsi API key AI
LIFUNZE_ADMIN_USERNAME=                   # seed admin pertama (Fase 1)
LIFUNZE_ADMIN_PASSWORD=                   # seed admin pertama (Fase 1); production minimal 12 karakter

# --- Production (VPS) ---
LIFUNZE_ENV=production                    # aktifkan validasi konfigurasi ketat saat startup
LIFUNZE_COOKIE_SECURE=true                # cookie sesi hanya lewat HTTPS
LIFUNZE_CORS_ORIGINS=["https://lifunze.aditiamh.my.id"]
NEXT_PUBLIC_API_BASE=                     # kosong = same-origin di balik Caddy

# --- Dev lokal tanpa Docker ---
# LIFUNZE_DATABASE_URL=sqlite:///./lifunze-dev.db
